name: Deploy FSO API
on:
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: fso-api
  cancel-in-progress: false
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm test
      - name: Deploy Supabase Edge Function
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SUPABASE_PROJECT_REF: ${{ vars.SUPABASE_PROJECT_REF }}
        shell: bash
        run: |
          if [ -z "$SUPABASE_ACCESS_TOKEN" ] || [ -z "$SUPABASE_PROJECT_REF" ]; then
            echo 'Configure the SUPABASE_ACCESS_TOKEN repository secret and SUPABASE_PROJECT_REF repository variable.'
            exit 1
          fi
          npx --yes supabase@latest functions deploy fso-api --project-ref "$SUPABASE_PROJECT_REF" --no-verify-jwt --use-api
